# syntax=docker/dockerfile:1
# Combined ga4gh-infra CLI (all-in-one) image. Build from repo root:
#   docker build -f docker/Dockerfile.all-in-one -t ghcr.io/<org>/ga4gh-infra:0.1.0 .

# Tag: rust:1-bookworm
FROM rust:1-bookworm@sha256:114c7a4425406451c2866b6aafe69fe29b1b298832db1277d411ac73c82d04d6 AS builder
WORKDIR /app

COPY docker/.cargo/config.toml .cargo/config.toml
COPY docker/vendor ./vendor
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY tests/integration ./tests/integration

RUN --mount=type=cache,target=/app/target,sharing=locked \
    cargo build --locked --release -p ga4gh-infra-cli \
    && install -D /app/target/release/ga4gh-infra /app/bin/ga4gh-infra

# Tag: debian:bookworm-slim
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587 AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1000 --system --home /app --shell /usr/sbin/nologin ga4gh \
    && mkdir -p /data && chown ga4gh:ga4gh /data

COPY --from=builder /app/bin/ga4gh-infra /usr/local/bin/ga4gh-infra

USER ga4gh
WORKDIR /app
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/ga4gh-infra"]
