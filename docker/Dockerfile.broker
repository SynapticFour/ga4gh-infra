# syntax=docker/dockerfile:1
# GA4GH AAI broker image. Build from repo root:
#   docker build -f docker/Dockerfile.broker -t ghcr.io/<org>/aai-broker:0.1.0 .

# Tag: rust:1.100.0-bookworm
FROM rust:1.100.0-bookworm@sha256:ade39a710ef85f3506cffcfec3e8a24ba090badef1dff2fb798f71d878833fea AS builder
WORKDIR /app

COPY docker/.cargo/config.toml .cargo/config.toml
COPY docker/vendor ./vendor
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY tests/integration ./tests/integration

RUN --mount=type=cache,target=/app/target,sharing=locked \
    cargo build --locked --release -p aai-broker \
    && install -D /app/target/release/aai-broker /app/bin/aai-broker

# Tag: debian:bookworm-slim
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587 AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1000 --system --home /app --shell /usr/sbin/nologin ga4gh

COPY --from=builder /app/bin/aai-broker /usr/local/bin/aai-broker

USER ga4gh
WORKDIR /app
ENTRYPOINT ["/usr/local/bin/aai-broker"]
