# Docker image version pins for docker/docker-compose.yml and docker-compose.sqlite.yml.
# Copy to docker/.env and adjust when mixing component versions.
#
# Stack/deploy tag follows git `ga4gh-infra-v*` (currently 0.2.2).
# Crate versions in Cargo.toml may stay 0.1.0 — those are library semver, not GHCR tags.
# Local `make up` builds images and applies these tags; it does not require GHCR.
# Per-service GHCR :0.2.2 ships when Docker Release runs on the next stack tag
# (cut `ga4gh-infra-v0.2.3`) — v0.2.2 on origin only pushed the all-in-one image.

GA4GH_IMAGE_PREFIX=ghcr.io/synapticfour

AAI_BROKER_VERSION=0.2.2
VISA_REGISTRY_VERSION=0.2.2
DUO_SERVICE_VERSION=0.2.2
SERVICE_REGISTRY_VERSION=0.2.2
SAMPLE_RESOURCE_VERSION=0.2.2
ACCESS_DECISION_SERVICE_VERSION=0.2.2
AGREEMENT_REGISTRY_VERSION=0.2.2
ADMIN_UI_VERSION=0.2.2
MOCK_IDP_VERSION=0.2.2
GA4GH_INFRA_VERSION=0.2.2
