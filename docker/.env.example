# Docker image version pins for docker/docker-compose.yml and docker-compose.sqlite.yml.
# Copy to docker/.env and adjust when mixing component versions.
#
# Stack/deploy tag follows git `ga4gh-infra-v*`.
# Checked 2026-10-14: git tag `ga4gh-infra-v0.2.8` is the same commit as origin/main.
# Local `make up` builds images and applies these labels. It does not pull GHCR tags.
# Crate versions in Cargo.toml may stay 0.1.0 — those are library semver, not GHCR tags.
# Historical: Docker Release on `ga4gh-infra-v0.2.3` published every Compose service as :0.2.3.
# v0.2.2 on origin only pushed the all-in-one image.
# This file does not claim that a Docker Release for 0.2.8 was inspected.

GA4GH_IMAGE_PREFIX=ghcr.io/synapticfour

AAI_BROKER_VERSION=0.2.8
VISA_REGISTRY_VERSION=0.2.8
DUO_SERVICE_VERSION=0.2.8
SERVICE_REGISTRY_VERSION=0.2.8
SAMPLE_RESOURCE_VERSION=0.2.8
ACCESS_DECISION_SERVICE_VERSION=0.2.8
AGREEMENT_REGISTRY_VERSION=0.2.8
ADMIN_UI_VERSION=0.2.8
MOCK_IDP_VERSION=0.2.8
GA4GH_INFRA_VERSION=0.2.8
