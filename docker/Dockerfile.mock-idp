# syntax=docker/dockerfile:1
# Mock OIDC IdP for dev/CI. Build from repo root:
#   docker build -f docker/Dockerfile.mock-idp -t ghcr.io/<org>/mock-idp:0.1.0 .

# Tag: rust:1-bookworm
FROM rust:1-bookworm@sha256:114c7a4425406451c2866b6aafe69fe29b1b298832db1277d411ac73c82d04d6 AS builder
WORKDIR /app

COPY docker/.cargo/config.toml .cargo/config.toml
COPY docker/vendor ./vendor
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY tests/integration ./tests/integration

RUN --mount=type=cache,target=/app/target,sharing=locked \
    cargo build --locked --release -p mock-idp \
    && install -D /app/target/release/mock-idp /app/bin/mock-idp

# Tag: debian:bookworm-slim
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587 AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1000 --system --home /app --shell /usr/sbin/nologin ga4gh

COPY --from=builder /app/bin/mock-idp /usr/local/bin/mock-idp

USER ga4gh
WORKDIR /app
ENTRYPOINT ["/usr/local/bin/mock-idp"]
